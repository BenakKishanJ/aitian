rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read all files
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    // Allow teachers and admins to upload to announcements folder
    match /announcements/{fileName} {
      allow write: if request.auth != null 
        && request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Allow teachers and admins to upload materials
    match /materials/{fileName} {
      allow write: if request.auth != null 
        && request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Allow students to upload submissions
    match /submissions/{fileName} {
      allow write: if request.auth != null 
        && request.auth.token.role == 'student';
    }
    
    // Allow users to upload profile photos (only their own)
    match /profile-photos/{userId}/{fileName} {
      allow write: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload documents
    match /documents/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
